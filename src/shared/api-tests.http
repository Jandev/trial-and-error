###

GET {{PythonService_HostAddress}}/agents/hello-world
Accept: application/json

### Count Letters - REST API endpoint
POST {{PythonService_HostAddress}}/agents/count-letters
Accept: application/json
Content-Type: application/json

{
    "question": "How many `r` are there in the word strawberry?"
}

### Count Letters - REST API endpoint (another test)
POST {{PythonService_HostAddress}}/agents/count-letters
Accept: application/json
Content-Type: application/json

{
    "question": "I want to know the square root of the number of times the letter `r` is found in `Strawberry`?"
}

### Count Letters - A2A JSON-RPC endpoint
POST {{PythonService_HostAddress}}/agents/count-letters-a2a
Accept: application/json
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "run",
    "params": {
        "message": {
            "kind": "message",
            "messageId": "msg-1",
            "role": "User",
            "parts": [
                {
                    "kind": "text",
                    "text": "How many r are there in the word strawberry?"
                }
            ]
        }
    },
    "id": 1
}

### Count Letters - Agent Card
GET {{PythonService_HostAddress}}/agents/count-letters/.well-known/agent-card.json
Accept: application/json

